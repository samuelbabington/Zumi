# Copy to .env.local and fill in.

# Random string, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# OAuth client type: Web application
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the site (optional locally; set it in production)
# APP_URL=https://zumi.example.com
